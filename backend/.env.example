# Copy to .env (and add .env to .gitignore)
DATABASE_URL=postgresql+asyncpg://emr:emr@localhost:5432/emr
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]

# Public URLs for OAuth/Duo redirects
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# --- UTEP campus login (Microsoft Entra ID) ---
# Duo MFA is enforced by UTEP on the IdP when users use Sign in with UTEP.
# Register a Web app in Entra; redirect URI must match ENTRA_REDIRECT_URI.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
ENTRA_DOMAIN_HINT=utep.edu
# Set true in production once Entra is live (hides demo password login).
AUTH_REQUIRE_UTEP_SSO=false
AUTH_ALLOW_LOCAL_LOGIN=true

# --- Duo Universal Prompt (optional; local password path only) ---
# Not needed when everyone uses Sign in with UTEP (campus Duo already applies).
DUO_CLIENT_ID=
DUO_CLIENT_SECRET=
DUO_API_HOSTNAME=
DUO_REDIRECT_URI=http://localhost:8000/api/v1/auth/duo/callback
