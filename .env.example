# Copy this file to .env and fill in real values.
# Never commit .env — it's gitignored on purpose.

# --- Database (async driver for FastAPI; Alembic derives sync URL) ---
DATABASE_URL=postgresql+asyncpg://emr:emr@localhost:5432/emr

# --- Backend ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (Vite) ---
# Leave empty in local dev to use the Vite proxy (/api → :8000).
# Set to the deployed API origin in production builds.
VITE_API_URL=
# Set to "true" only if you want the old in-memory mock (no backend).
VITE_USE_MOCK=false
