# Copy this file to .env and fill in real values.
# Never commit .env — it's gitignored on purpose.

# --- Database (async driver for FastAPI; Alembic derives sync URL) ---
DATABASE_URL=postgresql+asyncpg://emr:emr@localhost:5432/emr

# --- Backend ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# UTEP SSO (Microsoft Entra). Leave blank for educational local MFA.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
ENTRA_DOMAIN_HINT=utep.edu
AUTH_REQUIRE_UTEP_SSO=false
AUTH_ALLOW_LOCAL_LOGIN=true

# Duo Universal Prompt for local password MFA (optional).
DUO_CLIENT_ID=
DUO_CLIENT_SECRET=
DUO_API_HOSTNAME=
DUO_REDIRECT_URI=http://localhost:8000/api/v1/auth/duo/callback

# --- Frontend (Vite) ---
# Leave empty in local dev to use the Vite proxy (/api → :8000).
# Set to the deployed API origin in production builds.
VITE_API_URL=
# Set to "true" only if you want the old in-memory mock (no backend).
VITE_USE_MOCK=false
